<Window x:Class="Clipbook.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipbook" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <!-- Export options -->
        <StackPanel x:Name="ExportPanel">
            <CheckBox x:Name="PinnedOnlyBox" Content="Only pinned items"/>
            <CheckBox x:Name="ImagesBox" Content="Include images (makes the file bigger)" IsChecked="True"/>
            <CheckBox x:Name="SensitiveBox" Content="Include items that were marked sensitive"/>
            <TextBlock Text="Password (optional, recommended)" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="PasswordBox1" PasswordChanged="Password_Changed"/>
            <TextBlock Text="Repeat password" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="PasswordBox2" PasswordChanged="Password_Changed"/>
            <TextBlock x:Name="PasswordError" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" Margin="0,4,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Without a password, the file is plain JSON that anyone can read. With a password, it is encrypted (AES-256). If you forget the password, the backup cannot be opened."/>
        </StackPanel>

        <!-- Import options -->
        <StackPanel x:Name="ImportPanel">
            <TextBlock Text="Backup file" Style="{StaticResource Label}" Margin="0,0,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" IsReadOnly="True" Tag="Choose a .json or .clipbook file…"/>
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <StackPanel x:Name="ImportPasswordPanel" Visibility="Collapsed">
                <TextBlock Text="This backup is password-protected. Password:" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="ImportPasswordBox"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Nothing is deleted. Items you already have are skipped, but pins and collections from the backup are added to them. Imported items still follow your temporary-history limits."/>
        </StackPanel>

        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,2,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="CloseBtn" Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="ActionBtn" Style="{StaticResource AccentButton}" Click="Action_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
