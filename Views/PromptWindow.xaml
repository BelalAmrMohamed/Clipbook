<Window x:Class="AdvancedClipboard.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Clipboard" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource BgBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" Margin="0,0,0,8" PreviewKeyDown="Input_PreviewKeyDown"/>
        <WrapPanel x:Name="Suggestions" Margin="0,0,0,12" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
