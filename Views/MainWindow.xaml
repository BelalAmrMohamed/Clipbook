<Window x:Class="Clipbook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Clipbook.Models"
        Title="Clipbook" Width="400" Height="540" MinWidth="320" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="CanResize" ShowActivated="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Filter chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="10,3">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab header -->
        <Style x:Key="TabHeader" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" Margin="0,2,0,4"/>
                            <Border x:Name="u" Height="3" CornerRadius="2" Background="Transparent"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="u" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card container -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="{DynamicResource CardBrush}" CornerRadius="6"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipTemplate" DataType="{x:Type models:ClipItem}">
            <Grid Margin="12,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Link title (only if "Fetch page titles" is on in Settings) -->
                    <TextBlock Text="{Binding LinkTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="40"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                               Visibility="{Binding HasLinkTitle, Converter={StaticResource BoolToVis}}"/>
                    <!-- Text, with a colour swatch when the text is a colour like #ff8800 -->
                    <Grid Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Top"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrushX}"
                                Background="{Binding ColorSwatch}"
                                Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap" MaxHeight="72"
                                   TextTrimming="CharacterEllipsis" FontSize="13"/>
                    </Grid>
                    <!-- Image -->
                    <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" CornerRadius="4" ClipToBounds="True"
                            HorizontalAlignment="Left" MaxHeight="150">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="150"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <Button Content="&#xE712;" FontFamily="{StaticResource IconFont}" Style="{StaticResource FlatButton}"
                            Width="28" Height="28" Click="More_Click" ToolTip="More actions"/>
                    <Button x:Name="PinBtn" FontFamily="{StaticResource IconFont}" Style="{StaticResource FlatButton}"
                            Width="28" Height="28" Click="Pin_Click" ToolTip="{Binding PinTooltip}" Margin="0,6,0,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE718;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter Property="Text" Value="&#xE842;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10" Background="{DynamicResource BgBrush}" CornerRadius="10" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrushX}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag the panel by this row) -->
            <Grid Grid.Row="0" x:Name="HeaderBar" Background="Transparent" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Clipbook" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="QueueBtn" Content="&#xE8FD;" FontFamily="{StaticResource IconFont}" Style="{StaticResource FlatButton}"
                            Width="32" Height="28" ToolTip="Paste queue" Click="Queue_Click"/>
                    <Button Content="&#xE713;" FontFamily="{StaticResource IconFont}" Style="{StaticResource FlatButton}"
                            Width="32" Height="28" ToolTip="Settings" Click="Settings_Click"/>
                    <Button Content="Clear all" Style="{StaticResource OutlineButton}" Margin="4,0,0,0" Padding="10,4" Click="ClearAll_Click"
                            ToolTip="Delete everything that is not pinned"/>
                </StackPanel>
            </Grid>

            <!-- One row: quick-note input (or search) + search toggle + save -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Grows with extra lines up to MaxHeight, then scrolls. -->
                <TextBox x:Name="InputBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Padding="8,7"
                         Tag="Write a quick note…  (Ctrl+Enter to save)"
                         TextChanged="InputBox_TextChanged" PreviewKeyDown="InputBox_PreviewKeyDown"/>
                <Button x:Name="SearchToggle" Grid.Column="2" Style="{StaticResource FlatButton}" Width="34" Height="34" Margin="4,0,0,0"
                        VerticalAlignment="Top" Click="SearchToggle_Click" ToolTip="Search (Ctrl+F)">
                    <TextBlock x:Name="SearchToggleIcon" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </Button>
                <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Height="34"
                        VerticalAlignment="Top" Click="SaveNote_Click" ToolTip="Save as a note in Clipbook (Ctrl+Enter)"/>
            </Grid>

            <!-- Filters -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <RadioButton x:Name="ChipAll" Content="All" Style="{StaticResource Chip}" IsChecked="True" GroupName="type" Tag="" Checked="TypeChip_Checked"/>
                <RadioButton Content="Text" Style="{StaticResource Chip}" GroupName="type" Tag="Text" Checked="TypeChip_Checked"/>
                <RadioButton Content="Links" Style="{StaticResource Chip}" GroupName="type" Tag="Link" Checked="TypeChip_Checked"/>
                <RadioButton Content="Images" Style="{StaticResource Chip}" GroupName="type" Tag="Image" Checked="TypeChip_Checked"/>
                <RadioButton Content="Files" Style="{StaticResource Chip}" GroupName="type" Tag="Files" Checked="TypeChip_Checked"/>
                <RadioButton Content="Notes" Style="{StaticResource Chip}" GroupName="type" Tag="Note" Checked="TypeChip_Checked"/>
                <Button x:Name="AppFilterBtn" Content="App ▾" Style="{StaticResource FlatButton}" FontSize="12" Padding="8,2" Click="AppFilter_Click"/>
                <Button x:Name="CollectionFilterBtn" Content="Collection ▾" Style="{StaticResource FlatButton}" FontSize="12" Padding="8,2" Click="CollectionFilter_Click"/>
            </WrapPanel>

            <StackPanel Grid.Row="3">
                <!-- Paste queue: visible while collecting or while something is queued -->
                <Border x:Name="QueueBar" Visibility="Collapsed" Background="{DynamicResource CardBrush}" CornerRadius="6"
                        Padding="10,5,6,5" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QueueText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="QueueCollectBtn" Style="{StaticResource FlatButton}" FontSize="12" Padding="8,3" Click="QueueCollect_Click"/>
                            <Button x:Name="QueueNextBtn" Content="Paste next" Style="{StaticResource FlatButton}" FontSize="12" Padding="8,3"
                                    Click="QueueNext_Click"/>
                            <Button Content="&#xE712;" FontFamily="{StaticResource IconFont}" Style="{StaticResource FlatButton}"
                                    Width="26" Height="24" Click="QueueMore_Click" ToolTip="More queue actions"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs: only shown when pinned items live in their own tab -->
                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                    <RadioButton x:Name="HistoryTabBtn" Content="History" Style="{StaticResource TabHeader}" GroupName="tab"
                                 IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="PinnedTabBtn" Content="Pinned" Style="{StaticResource TabHeader}" GroupName="tab"
                                 Checked="Tab_Checked"/>
                </StackPanel>
            </StackPanel>

            <!-- List -->
            <Grid Grid.Row="4">
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource CardItem}" ItemTemplate="{StaticResource ClipTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         MouseLeftButtonUp="ItemsList_MouseLeftButtonUp" MouseRightButtonUp="ItemsList_MouseRightButtonUp"
                         PreviewKeyDown="ItemsList_PreviewKeyDown"/>
                <TextBlock x:Name="EmptyText" Text="Nothing here yet.&#x0A;Copy something, or write a note above."
                           TextAlignment="Center" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>

            <!-- Footer -->
            <TextBlock x:Name="FooterText" Grid.Row="5" Margin="2,8,2,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
